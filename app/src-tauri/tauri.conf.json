{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoCorrect Settings",
  "version": "0.1.0",
  "identifier": "vn.autocorrect.settings",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoCorrect – Cài đặt",
        "width": 760,
        "height": 640,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
